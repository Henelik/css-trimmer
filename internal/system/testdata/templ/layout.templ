package components

templ Layout() {
  <div class="container">
    <header class="header">
      <nav class="nav">
        <a class="nav-item" href="/">Home</a>
        <a class="nav-item" href="/about">About</a>
      </nav>
    </header>
    <main class="main-content">
      { children }
    </main>
    <footer class="footer">
      <p>&copy; 2026</p>
    </footer>
  </div>
}
